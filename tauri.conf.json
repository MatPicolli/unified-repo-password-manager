{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "URPM",
  "version": "1.5.0",
  "identifier": "app.urpm.senhas",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "URPM",
        "width": 400,
        "height": 620,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#0e1015"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MatPicolli",
    "copyright": "MatPicolli",
    "category": "Utility",
    "shortDescription": "Gerenciador de senhas cifradas no GitHub",
    "longDescription": "Cofres de senhas cifrados com Argon2id + XChaCha20-Poly1305 e sincronizados com um repositório privado do GitHub.",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
